# Copy to .env and edit:  cp .env.example .env
# Public BTC receiving address only (bc1..., 1..., 3...). NEVER a seed phrase or private key.
BTC_ADDRESS=

# Solo pool (host:port)
POOL=stratum.ckpool.org:3333

# Suggested share difficulty. The pool minimum is 10000, so a CPU would almost never show a share.
# 1 gives visible feedback and does not change your block odds. 0 = don't suggest.
SUGGEST_DIFFICULTY=1

# Worker name, shown on the pool as <address>.<worker>
WORKER=lotto

# Hashing threads. 0 = use all cores.
THREADS=0

# Telegram alerts (optional). Token from @BotFather is SECRET: keep it only in .env.
# Chat id: message your bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Seconds between log stats lines
STATS_INTERVAL=5

# Docker CPU limit (0 = unlimited, e.g. 4 = four cores)
CPU_LIMIT=0
